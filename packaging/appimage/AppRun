#!/bin/sh
# Entry point of the AppImage.
#
# The image carries all three programs, but not GTK4, libadwaita or qpdf: those
# come from the machine it runs on. That is what keeps the window in step with
# the desktop's own GNOME style, and it is why the program refuses to start with
# a readable message when the host is missing them.
#
#   ./ipp-duplexd-fork-<version>-x86_64.AppImage                          # window
#   ./ipp-duplexd-fork-<version>-x86_64.AppImage daemon --printer ipp://...# daemon
#   ./ipp-duplexd-fork-<version>-x86_64.AppImage setup                    # wizard
#
# `--daemon` and `--setup` work too, so `./x.AppImage --daemon --help` reads
# naturally.
set -e

if [ -z "${APPDIR-}" ]; then
    APPDIR=$(dirname "$(readlink -f "$0")")
fi
export APPDIR

# The image has no libraries of its own; anything it added to LD_LIBRARY_PATH
# would only shadow the desktop's, which is exactly what must not happen here.
PATH="$APPDIR/usr/bin:${PATH-}"
export PATH

# Ask the dynamic linker itself what it cannot resolve, which is the only
# answer that also honours LD_LIBRARY_PATH and a desktop that keeps its
# libraries somewhere unusual.
unresolved() {
    ldd "$APPDIR/usr/bin/ipp-duplexd-fork-gui" 2>/dev/null |
        while IFS= read -r line; do
            case $line in
                *"not found"*) printf '%s ' "${line%% *}" ;;
            esac
        done
}

case "${1-}" in
    daemon|--daemon)
        if ! command -v qpdf >/dev/null 2>&1; then
            echo "ipp-duplexd-fork: qpdf is not installed; install it (dnf install qpdf) or printing will fail" >&2
        fi
        shift
        exec "$APPDIR/usr/bin/ipp-duplexd-fork" "$@"
        ;;
    setup|--setup)
        shift
        exec "$APPDIR/usr/bin/ipp-duplexd-fork-setup" "$@"
        ;;
    *)
        absent=$(unresolved)
        if [ -n "$absent" ]; then
            echo "ipp-duplexd-fork: the window uses your desktop's GTK4 and libadwaita; missing: $absent" >&2
            echo "install them (Fedora: sudo dnf install gtk4 libadwaita; Debian/Ubuntu: sudo apt install libgtk-4-1 libadwaita-1-0), or use the packaged build instead" >&2
            exit 2
        fi
        exec "$APPDIR/usr/bin/ipp-duplexd-fork-gui" "$@"
        ;;
esac
