[Unit]
Description=Manual duplex virtual IPP printer
# the packaged README lives in a distro-specific directory (Fedora uses an
# unversioned name, Debian/Arch a fixed one), so point at the project instead
Documentation=https://github.com/Wraindrock/ipp-duplexd-fork
After=network.target
# the flip dialog needs the session's DISPLAY/WAYLAND_DISPLAY, which the
# desktop session imports into the user manager on its way to this target
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Put e.g.  IPP_DUPLEXD_ARGS=--printer ipp://127.0.0.1:631/printers/laser
# into ~/.config/ipp-duplexd.conf (see ipp-duplexd.conf.example).
EnvironmentFile=%h/.config/ipp-duplexd.conf
ExecStart=/usr/bin/ipp-duplexd $IPP_DUPLEXD_ARGS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
