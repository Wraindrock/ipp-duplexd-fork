# Maintainer: Sami Kalliomäki <sami@kalliomaki.me>
pkgname=ipp-duplexd-fork
# read straight from the crate; this PKGBUILD only builds the working tree
# The project version is YYYY.MM.DD-N (packaging/version.sh); Arch has no dash
# inside pkgver either, so the date is pkgver and the day's build counter is
# pkgrel.
version=$(sed -n 's/^version = "\(.*\)"/\1/p' "$startdir/../../Cargo.toml" | head -1)
pkgver=${version%%-*}
pkgrel=${version##*-}
if [[ "$pkgrel" == "$version" ]]; then
    pkgrel=1
fi
pkgdesc="Manual duplex printing via a loopback virtual IPP printer"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qpdf' 'gcc-libs' 'gtk4' 'libadwaita')
makedepends=('cargo')
# The tarball is produced from the working tree by ../build-arch.sh; its name
# carries no version, so it can never disagree with pkgver
source=("$pkgname.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname"
    export CARGO_TARGET_DIR=target
    cargo build --release --locked --features gui
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/ipp-duplexd-fork "$pkgdir/usr/bin/ipp-duplexd-fork"
    install -Dm755 target/release/ipp-duplexd-fork-setup "$pkgdir/usr/bin/ipp-duplexd-fork-setup"
    install -Dm755 target/release/ipp-duplexd-fork-gui "$pkgdir/usr/bin/ipp-duplexd-fork-gui"
    install -Dm644 packaging/ipp-duplexd-fork.service "$pkgdir/usr/lib/systemd/user/ipp-duplexd-fork.service"
    install -Dm644 packaging/ipp-duplexd-fork.conf.example "$pkgdir/usr/share/doc/$pkgname/ipp-duplexd-fork.conf.example"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
