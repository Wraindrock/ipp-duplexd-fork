[Unit]
Description=Manual duplex virtual IPP printer
# the packaged README lives in a distro-specific directory (Fedora uses an
# unversioned name, Debian/Arch a fixed one), so point at the project instead
Documentation=https://github.com/Wraindrock/ipp-duplexd-fork
After=network.target
# the flip dialog needs the session's DISPLAY/WAYLAND_DISPLAY, which the
# desktop session imports into the user manager on its way to this target
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# Put e.g.  IPP_DUPLEXD_FORK_ARGS=--printer ipp://127.0.0.1:631/printers/laser
# into ~/.config/ipp-duplexd-fork.conf (see ipp-duplexd-fork.conf.example).
# The '-' keeps the unit loadable when that file does not exist: the printers
# can also live in ~/.config/ipp-duplexd-fork/config.toml, which the window
# writes, and in that case the daemon needs no flags at all.
EnvironmentFile=-%h/.config/ipp-duplexd-fork.conf
ExecStart=/usr/bin/ipp-duplexd-fork $IPP_DUPLEXD_FORK_ARGS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
